<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Koras.ApiClient</PackageId>
    <RootNamespace>Koras.ApiClient</RootNamespace>
    <Description>A resilient, observable, secure-by-default HTTP API client framework for enterprise .NET: fluent requests, API key / bearer / OAuth2 client-credentials authentication, default-on retry and circuit breaking, pagination as IAsyncEnumerable, response caching, correlation IDs, OpenTelemetry-ready tracing and metrics, and normalized RFC 9457-aware errors — all composed on HttpClientFactory.</Description>
    <PackageTags>http;httpclient;api;client;rest;resilience;retry;circuit-breaker;oauth;authentication;pagination;caching;telemetry;opentelemetry;problemdetails</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koras.ApiClient.Abstractions\Koras.ApiClient.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
